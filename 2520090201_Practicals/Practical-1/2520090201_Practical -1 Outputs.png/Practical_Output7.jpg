id; border-radius: 50%; width: 8px; height: 14px; margin: 0px 0.0625rem; an=
imation: 1.8s ease-in-out 0s infinite normal none running eye; display: inl=
ine-block; position: relative; }

.peer-typing-choosing-sticker-eye::before { content: " "; background-color:=
 currentcolor; border-radius: 50%; width: 0.25rem; height: 0.25rem; animati=
on: 1.8s ease-in-out 0s infinite normal none running eye-move; display: blo=
ck; position: absolute; top: 50%; transform: translate(-1px, -50%); }

@keyframes dotFirst {=20
  0% { opacity: 0.8; transform: scale(0.666667); }
  50% { opacity: 0.8; transform: scale(0.666667); }
  75% { opacity: 1; transform: scale(1); }
  100% { opacity: 0.8; transform: scale(0.666667); }
}

@keyframes dotMiddle {=20
  0% { opacity: 0.9; transform: scale(0.833333); }
  12.5% { opacity: 0.8; transform: scale(0.666667); }
  62.5% { opacity: 0.8; transform: scale(0.666667); }
  87.5% { opacity: 1; transform: scale(1); }
  100% { opacity: 0.9; transform: scale(0.833333); }
}

@keyframes dotLast {=20
  0% { opacity: 1; transform: scale(1); }
  25% { opacity: 0.8; transform: scale(0.666667); }
  75% { opacity: 0.8; transform: scale(0.666667); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes upload {=20
  0% { transform: translate(-13px); }
  100% { transform: translate(13px); }
}

@keyframes eye {=20
  0% { transform: scale(1.1) translate(-0.75px); }
  12.5% { transform: scale(1) translate(0px); }
  25% { transform: scale(1.1) translate(0.375px); }
  50% { transform: scale(1.1) translate(0.75px); }
  62.5% { transform: scale(1) translate(0px); }
  75% { transform: scale(1.1) translate(-0.375px); }
  100% { transform: scale(1.1) translate(-0.75px); }
}

@keyframes eye-move {=20
  0% { transform: translate(-1px, -50%); }
  25% { transform: translate(3px, -50%); }
  50% { transform: translate(3px, -50%); }
  75% { transform: translate(-1px, -50%); }
  100% { transform: translate(-1px, -50%); }
}

