.rp { position: relative; }

.rp-overflow .c-ripple, .btn-menu-toggle.rp .c-ripple, .menu-horizontal-div=
-item.rp .c-ripple, .btn-corner.rp .c-ripple, .pinned-container-wrapper.rp =
.c-ripple, .btn-control-small.rp .c-ripple { border-radius: inherit; width:=
 100%; height: 100%; overflow: hidden; }

.rp-overflow .c-ripple__circle, .btn-menu-toggle.rp .c-ripple__circle, .men=
u-horizontal-div-item.rp .c-ripple__circle, .btn-corner.rp .c-ripple__circl=
e, .pinned-container-wrapper.rp .c-ripple__circle, .btn-control-small.rp .c=
-ripple__circle { overflow: hidden; }

.c-ripple { position: absolute; inset: 0px; }

html.is-safari .c-ripple { border-radius: inherit; mask-image: -webkit-radi=
al-gradient(center, circle cover, rgb(255, 255, 255) 100%, rgb(0, 0, 0) 100=
%); }

.c-ripple__circle { opacity: var(--ripple-max-opacity,1); background-color:=
 var(--ripple-color); animation-name: ripple-effect; animation-fill-mode: f=
orwards; animation-duration: var(--ripple-duration); transition: calc(var(-=
-ripple-duration) / 2) opacity, calc(var(--ripple-duration) / 2) background=
-color; pointer-events: none; border-radius: 50%; display: block; position:=
 absolute; transform: scale(0); }

.c-ripple__circle.hiding, .c-ripple__square.hiding { opacity: 0; }

@keyframes ripple-effect {=20
  0% { transform: scale(var(--ripple-start-scale)); }
  100% { transform: scale(var(--ripple-end-scale)); }
}

.sidebar-left-section { background-color: var(--surface-color); margin-bott=
om: var(--section-padding-bottom); box-shadow: var(--section-box-shadow); b=
order-radius: 24px; padding: 0.5rem 0px; }

.sidebar-left-section.no-shadow { box-shadow: none; }

.sidebar-left-section.no-margin-bottom { margin-bottom: 0px; }

.sidebar-left-section-content { margin: 0 var(--section-margin-inline); }

.sidebar-left-section-content > .btn-primary { margin: 0px; }

@media only screen and (max-width: 600px) {
  .sidebar-left-section-content > .btn-primary { border-radius: 0px; }
}

.sidebar-left-section-content.full-width { margin: 0px !important; }

.sidebar-left-section-content > .media-sticker-wrapper { flex: 0 0 auto; wi=
dth: 86px; height: 86px; margin: 1px auto 29px; position: relative; }

