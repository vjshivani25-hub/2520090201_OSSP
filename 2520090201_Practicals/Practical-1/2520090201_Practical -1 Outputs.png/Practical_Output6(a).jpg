--padding-horizontal: 1rem; --border-width: 1px; align-items: center; displ=
ay: flex; position: relative; }

.input-field .arrow-down { content: " "; cursor: pointer; border-top-color:=
 ; border-top-style: ; border-right-color: ; border-right-style: ; border-b=
ottom-color: ; border-bottom-style: ; border-left-color: ; border-left-styl=
e: ; border-image-source: ; border-image-slice: ; border-image-width: ; bor=
der-image-outset: ; border-image-repeat: ; vertical-align: middle; z-index:=
