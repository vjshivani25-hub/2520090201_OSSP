amily); font-size: var(--font-size) !important; color: var(--primary-text-c=
olor) !important; }

.input-field-input:-webkit-autofill { font-family: var(--font-family); font=
-size: var(--font-size) !important; color: var(--primary-text-color) !impor=
tant; }

.input-field-input:-webkit-autofill:hover { font-family: var(--font-family)=
; font-size: var(--font-size) !important; color: var(--primary-text-color) =
!important; }

.input-field-input:-webkit-autofill:focus { font-family: var(--font-family)=
; font-size: var(--font-size) !important; color: var(--primary-text-color) =
!important; }

.input-field-input:-webkit-autofill:active { font-family: var(--font-family=
); font-size: var(--font-size) !important; color: var(--primary-text-color)=
 !important; }

body.animation-level-0 .input-field-input { transition: none !important; }

html.no-touch .input-field-input:hover:not(:focus):not(.error):not(.valid),=
 html.no-touch .input-field-input:active:not(:focus):not(.error):not(.valid=
) { border-color: var(--primary-color); transition: border-color 0.2s; }

html.no-touch .input-field-input:hover:not(:focus):not(.error):not(.valid) =
~ label, html.no-touch .input-field-input:active:not(:focus):not(.error):no=
t(.valid) ~ label { color: var(--primary-color); }

.input-field-input:focus { border-color: var(--primary-color); }

.input-field-input.error { border-color: var(--danger-color); }

.input-field-input.error ~ label { color: var(--danger-color) !important; }

.input-field-input.error ~ .input-field-border { border-color: var(--danger=
-color) !important; }

.input-field-input.valid { border-color: rgb(38, 150, 47); }

.input-field-input.valid ~ label { color: rgb(38, 150, 47) !important; }

.input-field-input.valid ~ .input-field-border { border-color: rgb(38, 150,=
 47) !important; }

.input-field-input:focus ~ .arrow-down { border-color: var(--primary-color)=
; margin-top: -4px; transform: rotate(225deg); }

.input-field-input:focus ~ label, .input-field-input.force-focus ~ label { =
color: var(--primary-color); font-weight: var(--font-weight-bold); }

.input-field-input:focus ~ .input-field-border, .input-field-input.force-fo=
cus ~ .input-field-border { opacity: 1; }

.input-field-input:focus ~ label, .input-field-input:valid ~ label, .input-=
field-input:not(.is-empty) ~ label, .input-field-input:disabled ~ label, .i=
nput-field-input.force-focus ~ label { transform: translate(calc(-.1875rem =
+ 1rem - var(--padding-horizontal)), calc(var(--height) / -2 + .0625rem)) s=
cale(.75); opacity: 1; padding: 0px 0.3125rem; }

.input-field-input:not(:focus).is-empty ~ .input-field-placeholder ~ label =
{ opacity: 0; }

.input-field-input-fake { opacity: 0; pointer-events: none; z-index: -3; to=
p: 0px; bottom: auto !important; inset-inline: var(--imc-padding-inline-sta=
rt) var(--imc-padding-inline-end) !important; width: auto !important; heigh=
t: auto !important; position: absolute !important; }

.input-field .input-field-input[contenteditable=3D"false"] { opacity: var(-=
-disabled-opacity); pointer-events: none; }

.input-field-placeholder { color: var(--input-placeholder-color); pointer-e=
vents: none; opacity: 0; max-width: 100%; z-index: 1; white-space: nowrap; =
text-overflow: ellipsis; padding-inline-end: 0.5rem; display: block; positi=
on: absolute; inset-inline-start: var(--padding-horizontal); overflow: hidd=
en; }

body.animation-level-2 .input-field-placeholder { transform: translateX(cal=
c(1rem * var(--reflect))); transition: opacity var(--input-placeholder-tran=
sition) 10ms, transform var(--input-placeholder-transition) 10ms; }

.input-field-placeholder.is-empty { opacity: 1; }

