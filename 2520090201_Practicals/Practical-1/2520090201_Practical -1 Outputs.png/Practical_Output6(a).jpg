orwards; animation-duration: var(--ripple-duration); transition: calc(var(-=
-ripple-duration) / 2) opacity, calc(var(--ripple-duration) / 2) background=
-color; pointer-events: none; border-radius: 50%; display: block; position:=
 absolute; transform: scale(0); }

.c-ripple__circle.hiding, .c-ripple__square.hiding { opacity: 0; }

@keyframes ripple-effect {=20
  0% { transform: scale(var(--ripple-start-scale)); }
  100% { transform: scale(var(--ripple-end-scale)); }
}

.sidebar-left-section { background-color: var(--surface-color); margin-bott=
om: var(--section-padding-bottom); box-shadow: var(--section-box-shadow); b=
order-radius: 24px; padding: 0.5rem 0px; }

