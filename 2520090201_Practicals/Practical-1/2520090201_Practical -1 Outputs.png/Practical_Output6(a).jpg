0px; margin-top: -9px; padding: 5px; transition: 0.2s; display: inline-bloc=
k; position: absolute; top: 50%; bottom: 0px; right: 21px; transform: rotat=
e(45deg); }

.input-field label { color: rgb(158, 158, 158); top: 0px; inset-inline: var=
(--padding-horizontal) auto; z-index: 2; background-color: var(--surface-co=
lor); height: 1.5rem; transform-origin: var(--transform-origin-left-center)=
; pointer-events: none; margin-top: calc((var(--height) - 1.5rem) / 2); whi=
te-space: nowrap; position: absolute; transform: translate(0px); }

body.animation-level-2 .input-field label { transition: transform 0.2s, pad=
ding 0.2s, opacity 0.1s, font-weight 0.1s; }

.input-field-border { border: 2px solid var(--primary-color); opacity: 0; b=
order-radius: var(--border-radius); pointer-events: none; z-index: 1; posit=
ion: absolute; inset: 0px; }

body.animation-level-2 .input-field-border { transition: opacity 0.2s; }

.input-field-icon { z-index: 1; pointer-events: none; border-radius: 0.375r=
em; width: 1.5rem; height: 1.5rem; position: absolute; top: 50%; right: 1re=
m; transform: translateY(-50%); }

.input-field-input { border: var(--border-width) solid var(--input-search-b=
order-color); border-radius: var(--border-radius); background-color: var(--=
surface-color); padding: calc(var(--padding) - var(--border-width)) calc(va=
r(--padding-horizontal) - var(--border-width)); box-sizing: border-box; wid=
th: 100%; min-height: var(--height); z-index: 1; line-height: var(--line-he=
ight); transition: border-color; position: relative; }

.input-field-input:-webkit-autofill { box-shadow: 0 0 0px 1000px var(--surf=
ace-color) inset; }

