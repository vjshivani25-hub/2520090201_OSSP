int main()
{
    int fd[2];
    char buffer[100];

    pipe(fd);

    pid_t pid =3D fork();

    if(pid &gt; 0)
    {
        close(fd[0]);

        char message[] =3D "Hello Child Process";

        write(fd[1], message, strlen(message)+1);

        printf("Parent Produced: %s\n", message);

        close(fd[1]);

        wait(NULL);
    }
    else
    {
        close(fd[1]);

        read(fd[0], buffer, sizeof(buffer));

        printf("Child Consumed: %s\n", buffer);

        close(fd[0]);
    }

    return 0;
